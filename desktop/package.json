{
  "name": "classbeat-desktop",
  "private": true,
  "version": "0.5.7",
  "description": "ClassBeat 班级节律屏 · 桌面壳（Tauri 2）",
  "scripts": {
    "stage": "cargo run --quiet --release --manifest-path tools-rs/Cargo.toml -- stage --data sample",
    "verify": "cargo run --quiet --release --manifest-path tools-rs/Cargo.toml -- verify",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:nsis": "tauri build --bundles nsis",
    "build:msi": "tauri build --bundles msi"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
