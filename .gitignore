# 真实班级数据：学生姓名、教师姓名、班级名、学校素材照片。
# 这些东西只留在本机，绝不入库。公开仓库里用 sample/ 的化名数据。
data/
assets/

# 构建产物
app/data.js
out/
dist/
preview/

# 备份包（里面有真实名册，等同于 data/）
backups/

# 浏览器测试的依赖与产物
node_modules/
playwright-report/
test-results/
.pw-out-*/
e2e-results.json

# 运行时产生的消息，可能含老师写的话
server/messages.json
server/messages.json.bad
# 配置的唯一权威副本：班级名、老师姓名、学生名单，等同 data/，只在老师本机
server/config.json
server/config.json.tmp
# 上次启动的局域网地址，只对这台机器有意义
server/net.json
# 无窗运行时的日志与 pid（排错看它，不进仓库）
server/server.log
server/server.log.1
server/service.pid

# 本地工作文档（含真实姓名与真实数据推导），公开版在 docs/
